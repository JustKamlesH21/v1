# Example environment variables for running the pipeline
# Google Generative AI / Gemini
GOOGLE_API_KEY="YOUR_KEY_HERE"
# OR use Application Default Credentials (set GOOGLE_APPLICATION_CREDENTIALS to the JSON key file path)
GOOGLE_APPLICATION_CREDENTIALS=

# Neo4j (if using Neo4j backend)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=root

# AWS Neptune endpoint (if using Neptune)
NEPTUNE_ENDPOINT=wss://your-neptune-endpoint:8182/gremlin
